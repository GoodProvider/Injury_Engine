{# Injuries: how the speaker's wounded body parts feel right now, for every injury source. Data:                         #}
{# skyrimnet_whipped_injuries(uuid) from SkyrimNet_Whipped.dll (InjuryEngine); text from injuries/<source>.json.        #}
{% set injuries = skyrimnet_whipped_injuries(npc.UUID) %}
{% if existsIn(injuries, "sources") and length(injuries.sources) > 0 %}
{% for source in injuries.sources %}

{{ source.feels_intro }}
{% for part in source.parts %}
{% if part.feel != "" %}
- {{ part.feel }}
{% endif %}
{% endfor %}
{% if loop.is_last %}

{{ source.feels_outro }}
{% endif %}
{% endfor %}
{% endif %}
