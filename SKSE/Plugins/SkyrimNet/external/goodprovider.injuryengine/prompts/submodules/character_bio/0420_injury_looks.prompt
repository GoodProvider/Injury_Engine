{# Injuries: what each wounded body part looks like, for every injury source (whipping, slashing, ...). Data:            #}
{# injury_engine_injuries(uuid) from Injury_Engine.dll (InjuryEngine); the text is already resolved for this     #}
{# actor from SKSE/Plugins/Injury_Engine/injuries/<source>.json (see injuries/guide.md). Empty when nothing is hurt. #}
{% if render_mode == "full" or render_mode == "thoughts" or render_mode == "thought" or render_mode == "transform" or render_mode == "dialogue_target" %}
{% set injuries = injury_engine_injuries(actorUUID) %}
{% if existsIn(injuries, "sources") and length(injuries.sources) > 0 %}
{% for source in injuries.sources %}

{{ source.looks_heading }}
{% for part in source.parts %}
{% if part.look != "" %}
- {{ part.look }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endif %}
