<?xml version='1.0'?><!-- Game is either sse, tesv, or fo4 -->
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output="Scripts"
    Optimize="false"
    Release="false"
    Zip="false"
    Final="false">
    <Variables>
        <Variable Name="ModName" Value="Injury Engine" />
        <Variable Name="ModsFolder" Value="C:\Skyrim\dev\mods" />
    </Variables>

    <Imports>
        <Import>Scripts\Source</Import>
        <Import>@ModsFolder\SKSE64\Scripts\Source</Import>
        <Import>@ModsFolder\SkyrimNet\Source\Scripts</Import>
        <Import>@ModsFolder\PapyrusUtil SE - Modders Scripting Utility Functions\Scripts\Source</Import>
        <Import>C:\Skyrim\dev\skyrim\Data\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>Scripts\Source</Folder>
    </Folders>
</PapyrusProject>
