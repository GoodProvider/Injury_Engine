19750,"targetActor":0,"targetActorName":"","text":"[8 minutes ago] Maxxor read \"The Old Ways\"","type":"book_read"},{"actors":[350307820866579037,4245132286347294587],"data":{"action":"book_read","book_editor_id":"Book3ValuableMagicFromTheSky","book_form_id":109809,"book_name":"Magic from the Sky","book_title":"Magic from the Sky","from_world":true,"is_note":false},"gameTime":34831.667519,"gameTimeEnd":null,"gameTimeStr":"9:40 AM, Sundas, 17th of Last Seed, 4E 201","id":667,"localTime":1792283827.971439,"localTimeStr":"2026-10-18T01:37:07Z","location":"Hall of Attainment, Hold: Winterhold College","originatingActor":350307820866579037,"originatingActorName":"Maxxor","playtime":19768,"targetActor":0,"targetActorName":"","text":"[8 minutes ago] Maxxor read \"Magic from the Sky\"","type":"book_read"},{"actors":[350307820866579037,8505637216957485478],"data":{"player_name":"Maxxor","thoughts":"The author's perspective on celestial influence differs from our own teachings, but there's merit in the logic. I wonder if Enthir has any texts that expand on this."},"gameTime":34839.830017,"gameTimeEnd":null,"gameTimeStr":"9:40 AM, Sundas, 17th of Last Seed, 4E 201","id":668,"localTime":1792283830.70685,"localTimeStr":"2026-10-18T01:37:10Z","location":"Hall of Attainment, Hold: Winterhold College","originatingActor":350307820866579037,"originatingActorName":"Maxxor","playtime":19795,"targetActor":0,"targetActorName":"","text":"[7 minutes ago] {\"player_name\":\"Maxxor\",\"thoughts\":\"The author's perspective on celestial influence differs from our own teachings, but there's merit in the logic. I wonder if Enthir has any texts that expand on this.\"}","type":"player_thoughts"},{"actors":[350307820866579037,4245132286347294587],"data":{"dialogue":"[emotion-contemplation]Hmm. Fascinating theory on the origins of magic. ","player_name":"Maxxor","speaker":"Maxxor"},"gameTime":34839.87894,"gameTimeEnd":null,"gameTimeStr":"9:40 AM, Sundas, 17th of Last Seed, 4E 201","id":669,"localT